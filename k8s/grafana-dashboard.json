{
  "title": "Microservices Job Queue Dashboard",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Total Jobs Processed(SERVICE B)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(jobs_processed_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Errors",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(job_errors_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Jobs Submitted(SERVICE C)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "total_jobs_submitted",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Jobs Completed(SERVICE C)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "total_jobs_completed",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Queue Length(Redis)",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "queue_length",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "thresholdS": {
          "steps": [
            {
              "color": "green",
              "value": null
            },
            {
              "color": "yellow",
              "value": "50"
            },
            {
              "color": "red",
              "value": "200"
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Service B Replicas",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{deployment=\"service-b\"}",
          "refId": "A"
        }
      ]
    },

    {
      "type": "timeseries",
      "title": "Jobs Processed Rate (per minute)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(jobs_processed_total[1m])",
          "legendFormat": "pod: {{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job Processing Time (p50 / p95 / p99)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(job_processing_time_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(job_processing_time_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(job_processing_time_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage per Pod (Service B)",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"service-b\"}[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage per Pod (MB)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"service-b\"} / 1024 / 1024",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(job_errors_total[1m])",
          "legendFormat": "errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HPA Replica Count (Service B)",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"service-b-hpa\"}",
          "legendFormat": "current replicas",
          "refId": "A"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"service-b-hpa\"}",
          "legendFormat": "desired replicas",
          "refId": "B"
        }
      ]
    }
  ]
}
